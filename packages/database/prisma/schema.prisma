datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. CORE & AUTHENTICATION (Better Auth + Passkeys)
// ----------------------------------------------------

enum RoleType {
  SEKRETARIAT
  ADMIN_INSTANSI
  GURU_MADRASAH
  GURU_MI
  GURU
  PEGAWAI
  SANTRI
  WALI_SANTRI
}

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String              @unique
  nama_lengkap   String
  foto_url       String?
  email_verified Boolean             @default(false)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  deleted_at     DateTime?

  accounts       Account[]
  sessions       Session[]
  passkeys       PasskeyCredential[]
  user_roles     UserRole[]
  audit_logs     AuditLog[]
  
  guru           Guru?
  santri         Santri?
  wali_santri    WaliSantri?

  @@map("users")
}

model Account {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  session_token String   @unique
  ip_address    String?
  user_agent    String?
  expires_at    DateTime
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires_at DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasskeyCredential {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  credential_id String   @unique
  public_key    String
  counter       Int
  device_type   String
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("passkey_credentials")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        RoleType @unique
  description String?
  
  user_roles  UserRole[]

  @@map("roles")
}

model UserRole {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

// ----------------------------------------------------
// 2. KELEMBAGAAN & TENANT SAAS CONFIG
// ----------------------------------------------------

model Pondok {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama       String
  alamat     String
  telepon    String?
  logo_url   String?
  subdomain  String?   @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  madrasah   Madrasah[]
  mi         MI[]
  santri     Santri[]
  lokasi     LokasiPresensi[]
  inventaris InventarisBarang[]
  surat      Surat[]

  @@map("pondok")
}

model Madrasah {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondok_id  String    @db.Uuid
  nama       String
  npsn       String?   @unique
  created_at DateTime  @default(now())

  pondok Pondok  @relation(fields: [pondok_id], references: [id], onDelete: Cascade)
  kelas  Kelas[]

  @@map("madrasah")
}

model MI {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondok_id  String    @db.Uuid
  nama       String
  npsn       String?   @unique
  created_at DateTime  @default(now())

  pondok Pondok  @relation(fields: [pondok_id], references: [id], onDelete: Cascade)
  kelas  Kelas[]

  @@map("mi")
}

model Kelas {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  madrasah_id String?  @db.Uuid
  mi_id       String?  @db.Uuid
  nama_kelas  String
  tingkat     Int

  madrasah Madrasah?         @relation(fields: [madrasah_id], references: [id])
  mi       MI?               @relation(fields: [mi_id], references: [id])
  santri   Santri[]
  jadwal   JadwalPelajaran[]
  rapor    RaporSantri[]

  @@map("kelas")
}

// ----------------------------------------------------
// 3. CIVITAS (GURU, SANTRI, WALI)
// ----------------------------------------------------

model Guru {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique @db.Uuid
  nip          String?  @unique
  nama_lengkap String
  telepon      String?
  created_at   DateTime @default(now())

  user   User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  jadwal JadwalPelajaran[]

  @@map("guru")
}

model Santri {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.Uuid
  pondok_id             String    @db.Uuid
  kelas_id              String    @db.Uuid
  nisp                  String    @unique // NISP / Stambuk (Single Source of Truth)
  nisn                  String    @unique
  nis                   String?
  nik                   String?   // NIK Santri (16 Digit)
  nama_lengkap          String
  nama_panggilan        String?
  jenis_kelamin         String?   // L / P
  tempat_lahir          String?
  tanggal_lahir         String?
  anak_ke               Int?
  jumlah_saudara        Int?
  alamat                String?   // Alamat Kependudukan Lengkap (API Cahyadsn Wilayah)
  telepon               String?
  avatar_url            String?
  jenjang               String?   // Tsanawiyyah, Aliyah, Diniyah Ula/Wustho, MI
  kamar                 String?   // Asrama / Kamar
  status_tempat_tinggal String?   // PONDOK_PESANTREN / UNIT_LAIN
  hafalan_juz           Int?      @default(0)
  nik_wali              String?   // NIK Orang Tua / Wali untuk penyambungan akun otomatis
  nama_wali             String?
  telepon_wali          String?
  hubungan_wali         String?   // AYAH / IBU / WALI
  no_kk                 String?   // Nomor Kartu Keluarga
  deleted_at            DateTime?
  created_at            DateTime  @default(now())

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pondok     Pondok                 @relation(fields: [pondok_id], references: [id])
  kelas      Kelas                  @relation(fields: [kelas_id], references: [id])
  absensi    AbsensiLog[]
  wali_links HubunganWali[]
  nilai      NilaiSantri[]
  rapor      RaporSantri[]
  penempatan PenempatanPendidikan[]

  @@map("santri")
}

model PenempatanPendidikan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  santri_id    String   @db.Uuid
  nisp         String   // Stambuk
  tahun_ajaran String   // e.g. "2026/2027"
  semester     String   // "Ganjil" | "Genap"
  unit         String   // "MADRASAH" | "MI"
  tingkat      String   // e.g. "Tsanawiyyah" / "VI"
  kelas        String   // e.g. "2A" / "B"
  wali_kelas   String?  // Mustahiq / Wali Kelas
  status       String   @default("AKTIF")
  created_at   DateTime @default(now())

  santri Santri @relation(fields: [santri_id], references: [id], onDelete: Cascade)

  @@map("penempatan_pendidikan")
}

model MasterProvinsi {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_provinsi String   @unique // e.g. "35"
  nama_provinsi String   // e.g. "JAWA TIMUR"
  created_at    DateTime @default(now())

  kabupaten MasterKabupaten[]

  @@map("master_provinsi")
}

model MasterKabupaten {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_kabupaten String   @unique // e.g. "35.71"
  kode_provinsi  String   // Foreign key link to MasterProvinsi
  nama_kabupaten String   // e.g. "KOTA KEDIRI"
  created_at     DateTime @default(now())

  provinsi  MasterProvinsi    @relation(fields: [kode_provinsi], references: [kode_provinsi], onDelete: Cascade)
  kecamatan MasterKecamatan[]

  @@map("master_kabupaten")
}

model MasterKecamatan {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_kecamatan String   @unique // e.g. "35.71.01"
  kode_kabupaten String   // Foreign key link to MasterKabupaten
  nama_kecamatan String   // e.g. "MOJOROTO"
  created_at     DateTime @default(now())

  kabupaten MasterKabupaten @relation(fields: [kode_kabupaten], references: [kode_kabupaten], onDelete: Cascade)
  desa      MasterDesa[]

  @@map("master_kecamatan")
}

model MasterDesa {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_desa      String   @unique // e.g. "35.71.01.1001"
  kode_kecamatan String   // Foreign key link to MasterKecamatan
  nama_desa      String   // e.g. "LIRBOYO"
  created_at     DateTime @default(now())

  kecamatan MasterKecamatan @relation(fields: [kode_kecamatan], references: [kode_kecamatan], onDelete: Cascade)

  @@map("master_desa")
}

model WaliSantri {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique @db.Uuid
  nik          String?  @unique // NIK Kependudukan Wali
  nama_lengkap String
  telepon      String
  created_at   DateTime @default(now())

  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  santri_links HubunganWali[]

  @@map("wali_santri")
}

model Pengumuman {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul      String
  isi        String
  target     String   // SEMUA, WALI_SANTRI, GURU
  instansi   String   // PONDOK, MADRASAH, MI, SEMUA
  penulis    String
  penting    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("pengumuman")
}

model HubunganWali {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  santri_id      String @db.Uuid
  wali_santri_id String @db.Uuid
  hubungan       String

  santri      Santri     @relation(fields: [santri_id], references: [id], onDelete: Cascade)
  wali_santri WaliSantri @relation(fields: [wali_santri_id], references: [id], onDelete: Cascade)

  @@unique([santri_id, wali_santri_id])
  @@map("hubungan_wali")
}

// ----------------------------------------------------
// 4. PRESENSI & GEOFENCING
// ----------------------------------------------------

model LokasiPresensi {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondok_id    String   @db.Uuid
  nama_lokasi  String
  latitude     Float
  longitude    Float
  radius_meter Int      @default(200)
  created_at   DateTime @default(now())

  pondok  Pondok       @relation(fields: [pondok_id], references: [id], onDelete: Cascade)
  absensi AbsensiLog[]

  @@map("lokasi_presensi")
}

model QRSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qr_token   String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("qr_sessions")
}

enum StatusAbsensi {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPA
}

model AbsensiLog {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  santri_id          String        @db.Uuid
  lokasi_presensi_id String        @db.Uuid
  status             StatusAbsensi @default(HADIR)
  latitude_scan      Float
  longitude_scan     Float
  distance_meters    Int
  device_info        String?
  timestamp          DateTime      @default(now())

  santri Santri         @relation(fields: [santri_id], references: [id], onDelete: Cascade)
  lokasi LokasiPresensi @relation(fields: [lokasi_presensi_id], references: [id])

  @@map("absensi_logs")
}

// ----------------------------------------------------
// 5. AKADEMIK & JADWAL
// ----------------------------------------------------

model MataPelajaran {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kode_mapel String   @unique
  nama_mapel String
  kategori   String
  created_at DateTime @default(now())

  jadwal JadwalPelajaran[]
  nilai  NilaiSantri[]

  @@map("mata_pelajaran")
}

model JadwalPelajaran {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kelas_id          String   @db.Uuid
  guru_id           String   @db.Uuid
  mata_pelajaran_id String   @db.Uuid
  hari              String
  jam_mulai         String
  jam_selesai       String
  ruangan           String

  kelas          Kelas         @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  guru           Guru          @relation(fields: [guru_id], references: [id])
  mata_pelajaran MataPelajaran @relation(fields: [mata_pelajaran_id], references: [id])

  @@map("jadwal_pelajaran")
}

model NilaiSantri {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  santri_id         String   @db.Uuid
  mata_pelajaran_id String   @db.Uuid
  semester          String
  tahun_ajaran      String
  nilai_harian      Float
  nilai_uts         Float
  nilai_uas         Float
  nilai_akhir       Float

  santri         Santri        @relation(fields: [santri_id], references: [id], onDelete: Cascade)
  mata_pelajaran MataPelajaran @relation(fields: [mata_pelajaran_id], references: [id])

  @@map("nilai_santri")
}

model RaporSantri {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  santri_id     String   @db.Uuid
  kelas_id      String   @db.Uuid
  semester      String
  tahun_ajaran  String
  hafalan_juz   Int      @default(0)
  predikat_arab String   @default("MUMTAZ")
  catatan_wali  String?
  created_at    DateTime @default(now())

  santri Santri @relation(fields: [santri_id], references: [id], onDelete: Cascade)
  kelas  Kelas  @relation(fields: [kelas_id], references: [id])

  @@map("rapor_santri")
}

// ----------------------------------------------------
// ----------------------------------------------------
// 7. PERSURATAN & INVENTARIS
// ----------------------------------------------------

enum JenisSurat {
  SURAT_MASUK
  SURAT_KELUAR
  SURAT_IZIN_SANTRI
  SURAT_KETERANGAN
}

model Surat {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondok_id   String     @db.Uuid
  nomor_surat String     @unique
  jenis_surat JenisSurat
  perihal     String
  pengirim    String
  penerima    String
  tanggal     DateTime   @default(now())

  pondok Pondok @relation(fields: [pondok_id], references: [id], onDelete: Cascade)

  @@map("surat")
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  PERBAIKAN
}

model InventarisBarang {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondok_id   String        @db.Uuid
  kode_barang String        @unique
  nama_barang String
  kategori    String
  jumlah      Int           @default(1)
  kondisi     KondisiBarang @default(BAIK)
  lokasi      String
  created_at  DateTime      @default(now())

  pondok Pondok @relation(fields: [pondok_id], references: [id], onDelete: Cascade)

  @@map("inventaris_barang")
}

// ----------------------------------------------------
// 8. AUDIT LOG & SECURITY
// ----------------------------------------------------

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  metadata    Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
