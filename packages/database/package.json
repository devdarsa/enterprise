    "db:studio": "prisma studio",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
