# ============================================================
# DARSA ENTERPRISE — .gitignore
# ============================================================

# Dependencies
node_modules/
.pnpm-store/

# Next.js Build Output
.next/
out/
dist/
build/

# Environment Variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Turbo Cache
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS Files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Prisma
*.db
*.db-journal
/packages/database/prisma/migrations/

# Miscellaneous
*.pem
.vercel

.vercel
