# ----------------------------------------------------
# DARSA ENTERPRISE ENVIRONMENT VARIABLES
# ----------------------------------------------------

# Database (Neon PostgreSQL Connection String with PgBouncer Pooling)
DATABASE_URL="postgresql://darsa_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/darsa_db?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="darsa_super_secret_enterprise_key_change_in_production_32chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.1 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Upstash Redis Configuration (QR TOTP & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Cloudinary Storage Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="darsa-enterprise"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Firebase Cloud Messaging (FCM) Admin SDK
FCM_PROJECT_ID="darsa-enterprise-fcm"
FCM_CLIENT_EMAIL="firebase-adminsdk@darsa-enterprise.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----"
